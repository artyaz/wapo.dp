# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# design system source material — must not be scanned by tailwind
/extracted/
/upload/
/tool-results/
/download/
/skills/
/mini-services/

# agent-facing docs must not be scanned by tailwind
/BRIEFING.md
/worklog.md

# generation scripts must not be scanned by tailwind (they contain class-name literals)
/scripts/

# local sqlite db
db/*.db
